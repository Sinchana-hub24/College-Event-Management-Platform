# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Auth secret for signing session tokens (generate a long random string)
SESSION_SECRET="YOUR_SESSION_SECRET"

# MongoDB Atlas URI (used by Backend/database.py in the FastAPI deployment)
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/"
DATABASE_NAME="YOUR_DATABASE_NAME"
